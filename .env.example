# Database (Neon Postgres)
# Dapatkan dari https://console.neon.tech setelah membuat project
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# NextAuth
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-random-secret-yang-panjang"

# URL aplikasi (untuk NextAuth di production, isi dengan domain Vercel kamu)
# AUTH_URL="https://nama-app-kamu.vercel.app"
